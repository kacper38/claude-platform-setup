{
  "_about": "Hooks run tools/guard (both harnesses). The permissions block is a Claude-Code-only belt duplicating a subset of the guard rules; Copilot ignores it.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Read|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/guard/guard.py hook pre --wrapper claude",
            "timeout": 5,
            "statusMessage": "guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/memory/memstore.py hook",
            "timeout": 10,
            "statusMessage": "memstore"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/guard/guard.py hook fan-out --wrapper claude",
            "timeout": 5,
            "statusMessage": "guard"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/tracker/session_start.py",
            "timeout": 5,
            "statusMessage": "tracker"
          },
          {
            "type": "command",
            "command": "python3 tools/memory/memstore.py digest",
            "timeout": 5,
            "statusMessage": "memstore"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/telemetry/ledger.py hook",
            "timeout": 20,
            "statusMessage": "ledger"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Write(**/.env.production)",
      "Write(**/.env.development)",
      "Write(**/.env.staging)",
      "Write(**/.env.test)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.production)",
      "Edit(**/.env.development)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.test)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(**/*.tfstate)",
      "Write(**/*.tfstate.backup)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.tfstate)",
      "Edit(**/*.tfstate.backup)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git push --no-verify*)"
    ],
    "ask": [
      "Write(**/*.tfvars)",
      "Edit(**/*.tfvars)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/*.tfstate)",
      "Read(~/.aws/credentials)",
      "Read(~/.kube/config)",
      "Read(~/.ssh/id_*)"
    ]
  }
}
